# Edge Node Identity (Must match EDGE_NODE_API_KEY in backend/.env)
EDGE_NODE_API_KEY=YOUR_EDGE_NODE_API_KEY

# Backend API URL
BACKEND_API_URL=http://localhost:8000

# Camera Source: 0 is usually integrated camera, 1 is usually first external USB webcam
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# YOLO Configuration
YOLO_MODEL_PATH=models/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
TARGET_CLASS_NAME=box

# Counting Line Configuration (adjust for conveyor/feed geometry)
LINE_START_X=0
LINE_START_Y=400
LINE_END_X=1280
LINE_END_Y=400

# Event Spool Configuration (defaults to data/event_spool.db)
# EVENT_SPOOL_PATH=data/event_spool.db
